# توكن البوت من https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_APP_ID=

# مالك البوت — الوحيد الذي يملك لوحة الهوية العالمية
BOT_OWNER_ID=

# PostgreSQL
DATABASE_URL=postgresql://user:pass@localhost:5432/discord_games

# الرندر
RENDER_POOL_SIZE=4
RENDER_TIMEOUT_MS=8000

# ————————————————— خادم الـ API لتطبيق iOS (npm run api) —————————————————
# لا تكتب أي قيمة حقيقية في هذا الملف — المستودع عام.

# منفذ الاستماع (افتراضي 8080)
PORT=8080

# عنوان الخادم كما يراه ديسكورد والتطبيق. لا بد أن يكون
# <API_PUBLIC_URL>/auth/callback مسجَّلًا حرفيًا في Redirects داخل
# بوابة المطوّرين، وإلا رفض ديسكورد تبادل الرمز.
API_PUBLIC_URL=http://localhost:8080

# مفتاح توقيع رموز الجلسة (HS256) وحالة الـ OAuth.
# ولّده بـ: openssl rand -base64 48
# تغييره يُسجّل خروج كل الأجهزة فورًا.
API_JWT_SECRET=

# سرّ تطبيق ديسكورد — OAuth2 → Client Secret.
# يبقى على الخادم وحده ولا يُرسل للتطبيق أبدًا.
DISCORD_CLIENT_SECRET=

# معرّف العميل في OAuth. هو نفسه DISCORD_APP_ID أعلاه،
# فاتركه فارغًا ما لم تختلف القيمتان.
DISCORD_CLIENT_ID=

# وجهات عودة إضافية مسموح بها بعد تسجيل الدخول، مفصولة بفواصل.
# `gamesapp://auth` مسموحة دائمًا. القائمة البيضاء هي ما يمنع
# تحويل /auth/start إلى جسر open redirect يسرق رموز الجلسات.
API_REDIRECT_ALLOWLIST=
